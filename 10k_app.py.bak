if selected_tab == "3. Popularity (Regression)":

    st.header(
        "Popularity Prediction"
    )

    st.markdown(
        "Use book statistics and publication year to estimate "
        "average ratings."
    )

    st.divider()


    try:

        reg_df, reg_model = (
            train_regression()
        )


        col1, col2 = st.columns(2)


        with col1:

            year_range = st.slider(
                "Publication Year Range",
                1900,
                2026,
                (1990, 2010)
            )


        with col2:

            ratings_range = st.slider(
                "Ratings Count Range",
                0,
                500000,
                (1000, 50000),
                step=1000
            )


        if st.button(
            "Predict & Recommend Most Popular",
            key="reg_btn"
        ):

            filtered = reg_df[
                (
                    reg_df[
                        "original_publication_year"
                    ] >= year_range[0]
                )
                &
                (
                    reg_df[
                        "original_publication_year"
                    ] <= year_range[1]
                )
                &
                (
                    reg_df[
                        "ratings_count"
                    ] >= ratings_range[0]
                )
                &
                (
                    reg_df[
                        "ratings_count"
                    ] <= ratings_range[1]
                )
            ]


            if filtered.empty:

                st.warning(
                    "No books match these filters."
                )

            else:

                top_popular = (
                    filtered
                    .sort_values(
                        "predicted_popularity",
                        ascending=False
                    )
                    .head(10)
                )


                st.subheader(
                    "Recommended Books"
                )


                for _, row in (
                    top_popular.iterrows()
                ):

                    try:

                        yr = int(
                            row[
                                "original_publication_year"
                            ]
                        )

                    except Exception:

                        yr = "N/A"


                    st.info(
                        f"**{row['title']}** "
                        f"({yr})  •  "
                        f"Actual: "
                        f"{row['average_rating']:.2f}  •  "
                        f"Predicted: "
                        f"{row['predicted_popularity']:.2f}  •  "
                        f"Ratings: "
                        f"{row['ratings_count']}"
                    )


    except Exception as e:

        st.error(
            f"Error running regression: {e}"
        )


