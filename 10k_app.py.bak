# --- EXTRACTED FUNCTIONS ---
@st.cache_resource
def load_cb_artifacts():


    with open(
        os.path.join(
            CB_ARTIFACTS,
            "tfidf_vectorizer.pkl"
        ),
        "rb"
    ) as f:


        v = pickle.load(f)




    with open(
        os.path.join(
            CB_ARTIFACTS,
            "tfidf_matrix.pkl"
        ),
        "rb"
    ) as f:


        m = pickle.load(f)




    with open(
        os.path.join(
            CB_ARTIFACTS,
            "books_indexed.pkl"
        ),
        "rb"
    ) as f:


        d = pickle.load(f)




    return v, m, d




@st.cache_resource
def compute_svd_model():


    r_sub = ratings_df.head(
        100000
    ).copy()




    user_ids = (
        r_sub["user_id"]
        .astype("category")
        .cat.codes
    )




    book_ids = (
        r_sub["book_id"]
        .astype("category")
        .cat.codes
    )




    sparse_matrix = coo_matrix(
        (
            r_sub["rating"],
            (
                user_ids,
                book_ids
            )
        )
    )




    sparse_matrix = (
        sparse_matrix.asfptype()
    )




    k = min(
        50,
        min(sparse_matrix.shape) - 1
    )




    U, sigma, Vt = svds(
        sparse_matrix,
        k=k
    )




    sigma = np.diag(
        sigma
    )




    all_user_predicted_ratings = (
        np.dot(
            np.dot(
                U,
                sigma
            ),
            Vt
        )
    )




    user_categories = (
        r_sub["user_id"]
        .astype("category")
        .cat.categories
    )




    book_categories = (
        r_sub["book_id"]
        .astype("category")
        .cat.categories
    )




    return (
        all_user_predicted_ratings,
        user_categories,
        book_categories
    )




@st.cache_resource
def train_regression():


    df = books_df.dropna(
        subset=[
            "average_rating",
            "ratings_count",
            "work_text_reviews_count",
            "original_publication_year"
        ]
    ).copy()




    X = df[
        [
            "ratings_count",
            "work_text_reviews_count",
            "original_publication_year"
        ]
    ]




    y = df[
        "average_rating"
    ]




    model = LinearRegression()




    model.fit(
        X,
        y
    )




    df[
        "predicted_popularity"
    ] = model.predict(X)




    return (
        df,
        model
    )




class NeuMF(nn.Module):


    def __init__(
        self,
        num_users,
        num_items,
        gmf_dim=16,
        mlp_dim=32
    ):


        super(
            NeuMF,
            self
        ).__init__()




        self.gmf_user_embedding = nn.Embedding(
            num_users,
            gmf_dim
        )




        self.gmf_item_embedding = nn.Embedding(
            num_items,
            gmf_dim
        )




        self.mlp_user_embedding = nn.Embedding(
            num_users,
            mlp_dim
        )




        self.mlp_item_embedding = nn.Embedding(
            num_items,
            mlp_dim
        )




        self.mlp_layers = nn.Sequential(


            nn.Linear(
                mlp_dim * 2,
                128
            ),


            nn.ReLU(),


            nn.Dropout(
                0.3
            ),


            nn.Linear(
                128,
                64
            ),


            nn.ReLU(),


            nn.Dropout(
                0.2
            ),


            nn.Linear(
                64,
                32
            ),


            nn.ReLU(),


            nn.Linear(
                32,
                16
            ),


            nn.ReLU()
        )




        self.prediction_layer = nn.Sequential(


            nn.Linear(
                gmf_dim + 16,
                1
            ),


            nn.Sigmoid()
        )




    def forward(
        self,
        user_indices,
        item_indices
    ):


        gmf_u = (
            self.gmf_user_embedding(
                user_indices
            )
        )




        gmf_i = (
            self.gmf_item_embedding(
                item_indices
            )
        )




        gmf_vector = (
            gmf_u * gmf_i
        )




        mlp_u = (
            self.mlp_user_embedding(
                user_indices
            )
        )




        mlp_i = (
            self.mlp_item_embedding(
                item_indices
            )
        )




        mlp_vector = torch.cat(
            [
                mlp_u,
                mlp_i
            ],
            dim=-1
        )




        mlp_vector = (
            self.mlp_layers(
                mlp_vector
            )
        )




        predict_vector = torch.cat(
            [
                gmf_vector,
                mlp_vector
            ],
            dim=-1
        )




        prediction = (
            self.prediction_layer(
                predict_vector
            )
        )




        return prediction.squeeze(-1)




    # ====================================================
    # EXPLANATION COMPONENTS
    # ====================================================


    def get_explanation_components(
        self,
        user_indices,
        item_indices
    ):


        gmf_u = (
            self.gmf_user_embedding(
                user_indices
            )
        )




        gmf_i = (
            self.gmf_item_embedding(
                item_indices
            )
        )




        gmf_vector = (
            gmf_u * gmf_i
        )




        mlp_u = (
            self.mlp_user_embedding(
                user_indices
            )
        )




        mlp_i = (
            self.mlp_item_embedding(
                item_indices
            )
        )




        mlp_input = torch.cat(
            [
                mlp_u,
                mlp_i
            ],
            dim=-1
        )




        mlp_vector = (
            self.mlp_layers(
                mlp_input
            )
        )




        prediction_vector = torch.cat(
            [
                gmf_vector,
                mlp_vector
            ],
            dim=-1
        )




        prediction = (
            self.prediction_layer(
                prediction_vector
            )
        )




        return (
            gmf_vector,
            mlp_vector,
            prediction.squeeze(-1)
        )




# ========================================================
# LOAD NCF
# ========================================================


@st.cache_resource
def load_ncf():


    with open(
        os.path.join(
            NCF_DIR,
            "user_id_index.pkl"
        ),
        "rb"
    ) as f:


        u_index = pickle.load(f)




    with open(
        os.path.join(
            NCF_DIR,
            "book_id_index.pkl"
        ),
        "rb"
    ) as f:


        b_index = pickle.load(f)




    model = NeuMF(
        len(u_index),
        len(b_index)
    )




    model_path = os.path.join(
        NCF_DIR,
        "neumf_model.pt"
    )




    try:


        state_dict = torch.load(
            model_path,
            map_location=torch.device("cpu"),
            weights_only=True
        )


    except TypeError:


        state_dict = torch.load(
            model_path,
            map_location=torch.device("cpu")
        )




    model.load_state_dict(
        state_dict
    )




    model.eval()




    return (
        u_index,
        b_index,
        model
    )




