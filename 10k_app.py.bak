@st.cache_data
def load_base_data():

    books = pd.read_csv(
        os.path.join(
            DATA_DIR,
            "books.csv"
        )
    )

    ratings = pd.read_csv(
        os.path.join(
            DATA_DIR,
            "ratings.csv"
        )
    )

    return books, ratings


