        selected_u = st.selectbox(
            "Select User",
            sample_users_svd,
            key="svd_user",
            format_func=lambda x:
                f"👤 User {x}"
        )


        user_history = (
            ratings_df[
                ratings_df["user_id"] == selected_u
            ]
            .merge(
                books_df,
                on="book_id"
            )
            .sort_values(
                "rating",
                ascending=False
            )
            .head(5)
        )


        st.markdown(
            f"**User {selected_u}'s top-rated books:**"
        )


        cols = st.columns(5)


        for idx, (_, row) in enumerate(
            user_history.iterrows()
        ):

            if idx >= 5:
                break


            with cols[idx]:

                try:

                    image_url = row.get(
                        "image_url",
                        None
                    )

                    if (
                        pd.notna(image_url)
                        and str(image_url).strip()
                    ):

                        st.image(
                            image_url,
                            use_container_width=True
                        )

                except Exception:
                    pass


                try:

                    stars = (
                        "⭐"
                        * int(row["rating"])
                    )

                except Exception:

                    stars = ""


                st.caption(
                    f"{str(row['title'])[:30]}...\n"
                    f"{stars}"
                )


        if st.button(
            "Get Collaborative Recommendations",
            key="svd_btn"
        ):

            u_idx = np.where(
                user_cat == selected_u
            )[0][0]


            user_preds = preds[
                u_idx,
                :
            ]


            top_book_indices = (
                user_preds
                .argsort()[::-1][:10]
            )


            st.subheader(
                "Recommended Books"
            )


            for idx in top_book_indices:

                b_id = book_cat[idx]


                b_info = books_df[
                    books_df["book_id"] == b_id
                ]


                if not b_info.empty:

                    st.success(
                        f"**{b_info.iloc[0]['title']}** "
                        f"  •  Predicted Rating: "
                        f"{user_preds[idx]:.2f}"
                    )


    except Exception as e:

        st.error(
            f"Could not compute SVD: {e}"
        )


