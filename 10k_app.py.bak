# TAB 6
# EXPLAINABILITY & VISUALIZATION
# ============================================================

if selected_tab == "6. Explainability & Visualization":

    st.header(
        "Explainability & Visualization"
    )

    st.markdown(
        "Explore recommendation scores, learned representations, "
        "book embeddings and model comparisons."
    )

    st.divider()


    try:

        # ====================================================
        # LOAD NCF
        # ====================================================

        u_index_exp, b_index_exp, ncf_model_exp = (
            load_ncf()
        )


        explain_users = list(
            u_index_exp.keys()
        )[:50]


        selected_exp_user = st.selectbox(
            "Select User",
            explain_users,
            key="explain_user",
            format_func=lambda x:
                f"👤 User {x}"
        )


        explain_user_idx = u_index_exp[
            selected_exp_user
        ]


        # ====================================================
        # BOOKS
        # ====================================================

        explain_book_ids = list(
            b_index_exp.keys()
        )[:500]


        explain_item_indices = [
            b_index_exp[bid]
            for bid in explain_book_ids
        ]


        explain_user_tensor = torch.tensor(
            [explain_user_idx]
            * len(
                explain_item_indices
            ),
            dtype=torch.long
        )


        explain_item_tensor = torch.tensor(
            explain_item_indices,
            dtype=torch.long
        )


        # ====================================================
        # PREDICTIONS
        # ====================================================

        with torch.no_grad():

            explain_predictions = (
                ncf_model_exp(
                    explain_user_tensor,
                    explain_item_tensor
                )
                .cpu()
                .numpy()
            )


        top_explain_indices = (
            explain_predictions
            .argsort()[::-1][:10]
        )


        # ====================================================
        # RECOMMENDATION SCORES
        # ====================================================

        st.subheader(
            "Recommendation Scores"
        )


        recommendation_rows = []


        for idx in top_explain_indices:

            book_id = (
                explain_book_ids[idx]
            )


            book_info = books_df[
                books_df["book_id"]
                == book_id
            ]


            if not book_info.empty:

                recommendation_rows.append({

                    "Book":
                        str(
                            book_info.iloc[0]["title"]
                        )[:35],

                    "NeuMF Score":
                        float(
                            explain_predictions[idx]
                        )

                })


        recommendation_df = pd.DataFrame(
            recommendation_rows
        )


        if not recommendation_df.empty:

            st.dataframe(
                recommendation_df,
                use_container_width=True,
                hide_index=True
            )


            st.bar_chart(
                recommendation_df.set_index(
                    "Book"
                )
            )


        st.info(
            "Higher NeuMF scores indicate stronger predicted "
            "user-item interactions."
        )


        # ====================================================
        # GMF VS MLP
        # ====================================================

        st.subheader(
            "GMF vs MLP Representation"
        )


        best_idx = (
            top_explain_indices[0]
        )


        best_book_id = (
            explain_book_ids[best_idx]
        )


        best_item_idx = b_index_exp[
            best_book_id
        ]


        one_user_tensor = torch.tensor(
            [explain_user_idx],
            dtype=torch.long
        )


        one_item_tensor = torch.tensor(
            [best_item_idx],
            dtype=torch.long
        )


        with torch.no_grad():

            (
                gmf_vector,
                mlp_vector,
                final_prediction
            ) = ncf_model_exp.get_explanation_components(
                one_user_tensor,
                one_item_tensor
            )


        gmf_values = (
            gmf_vector
            .cpu()
            .numpy()
            .flatten()
        )


        mlp_values = (
            mlp_vector
            .cpu()
            .numpy()
            .flatten()
        )


        col1, col2 = st.columns(2)


        with col1:

            gmf_df = pd.DataFrame({

                "Dimension":
                    range(
                        1,
                        len(gmf_values) + 1
                    ),

                "GMF Value":
                    gmf_values

            })


            st.markdown(
                "**GMF**"
            )


            st.bar_chart(
                gmf_df.set_index(
                    "Dimension"
                )
            )


        with col2:

            mlp_df = pd.DataFrame({

                "Dimension":
                    range(
                        1,
                        len(mlp_values) + 1
                    ),

                "MLP Value":
                    mlp_values

            })


            st.markdown(
                "**MLP**"
            )


            st.bar_chart(
                mlp_df.set_index(
                    "Dimension"
                )
            )


        # ====================================================
        # PCA
        # ====================================================

        st.subheader(
            "Book Embeddings"
        )


        pca_book_ids = list(
            b_index_exp.keys()
        )[:100]


        pca_indices = [
            b_index_exp[bid]
            for bid in pca_book_ids
        ]


        embedding_matrix = (
            ncf_model_exp
            .gmf_item_embedding
            .weight[
                pca_indices
            ]
            .detach()
            .cpu()
            .numpy()
        )


        if (
            len(embedding_matrix) >= 2
            and embedding_matrix.shape[1] >= 2
        ):

            pca = PCA(
                n_components=2
            )


            embedding_2d = (
                pca.fit_transform(
                    embedding_matrix
                )
            )


            pca_df = pd.DataFrame({

                "PC1":
                    embedding_2d[:, 0],

                "PC2":
                    embedding_2d[:, 1]

            })


            st.scatter_chart(
                pca_df,
                x="PC1",
                y="PC2"
            )


            st.info(
                "PCA projects the learned book embeddings into "
                "two dimensions so their learned relationships "
                "can be viewed visually."
            )


        # ====================================================
        # SCORE DISTRIBUTION
        # ====================================================

        st.subheader(
            "Recommendation Score Distribution"
        )


        score_distribution_df = pd.DataFrame({

            "NeuMF Score":
                explain_predictions

        })


        st.line_chart(
            score_distribution_df
        )


        # ====================================================
        # MODEL COMPARISON
        # ====================================================

        st.subheader(
            "Recommendation Model Comparison"
        )


        comparison_df = pd.DataFrame({

            "Model": [
                "Content-Based",
                "Collaborative SVD",
                "Popularity Regression",
                "NeuMF"
            ],

            "Technique": [
                "TF-IDF + Cosine Similarity",
                "SVD Matrix Factorization",
                "Linear Regression",
                "GMF + MLP"
            ],

            "Input": [
                "Book metadata",
                "User-item ratings",
                "Book statistics",
                "User-item interactions"
            ],

            "Output": [
                "Similar books",
                "User recommendations",
                "Predicted rating",
                "Neural recommendations"
            ]

        })


        st.dataframe(
            comparison_df,
            use_container_width=True,
            hide_index=True
        )


        # ====================================================
        # REGRESSION FEATURES
        # ====================================================

        st.subheader(
            "Popularity Model Features"
        )


        regression_explain_df = (
            books_df
            .dropna(
                subset=[
                    "average_rating",
                    "ratings_count",
                    "work_text_reviews_count",
                    "original_publication_year"
                ]
            )
            .copy()
        )


        X_explain = regression_explain_df[
            [
                "ratings_count",
                "work_text_reviews_count",
                "original_publication_year"
            ]
        ]


        y_explain = regression_explain_df[
            "average_rating"
        ]


        explain_reg_model = (
            LinearRegression()
        )


        explain_reg_model.fit(
            X_explain,
            y_explain
        )


        coefficient_df = pd.DataFrame({

            "Feature":
                X_explain.columns,

            "Coefficient":
                explain_reg_model.coef_

        })


        st.dataframe(
            coefficient_df,
            use_container_width=True,
            hide_index=True
        )


        st.bar_chart(
            coefficient_df.set_index(
                "Feature"
            )
        )


        # ====================================================
        # CONCLUSION
        # ====================================================

        st.divider()

        st.subheader(
            "Conclusion"
        )


        st.success(
            "The visualizations provide a simple view of how the "
            "recommendation system behaves. Recommendation scores, "
            "neural representations, book embeddings and model "
            "features can be inspected directly from the application."
        )


    except Exception as e:

        st.error(
            f"Explainability error: {e}"
        )


