# ============================================================
# TAB 1
# CONTENT-BASED RECOMMENDER
# ============================================================

if selected_tab == "1. Content-Based (TF-IDF)":

    st.header(
        "Content-Based Recommender"
    )

    st.markdown(
        "Find books with similar content using TF-IDF and "
        "cosine similarity."
    )

    st.divider()


    try:

        v, m, cb_books = load_cb_artifacts()


        st.markdown(
            "**Select books you like:**"
        )


        selected_books = st.multiselect(
            "Search for books",
            options=cb_books[
                "title"
            ].dropna().unique(),
            key="cb_select"
        )


        if st.button(
            "Get Content-Based Recommendations",
            key="cb_btn"
        ):

            if selected_books:

                matches = cb_books[
                    cb_books["title"].isin(
                        selected_books
                    )
                ]


                input_pos = [
                    cb_books.index.get_loc(i)
                    for i in matches.index
                ]


                if input_pos:

                    q = np.asarray(
                        m[
                            input_pos
                        ].mean(axis=0)
                    )


                    sim = cosine_similarity(
                        q,
                        m
                    ).flatten()


                    for p in input_pos:

                        sim[p] = -1


                    c_pos = sim.argsort()[
                        -(10 * 3):
                    ][::-1]


                    cands = cb_books.iloc[
                        c_pos
                    ].copy()


                    cands[
                        "sim_score"
                    ] = sim[c_pos]


                    results = (
                        cands
                        .sort_values(
                            [
                                "average_rating",
                                "sim_score"
                            ],
                            ascending=False
                        )
                        .head(10)
                    )


                    st.subheader(
                        "Recommended Books"
                    )


                    for _, res in results.iterrows():

                        st.info(
                            f"**{res['title']}** "
                            f"by {res['authors']} "
                            f"  •  Similarity: "
                            f"{res['sim_score']:.2f}"
                        )

            else:

                st.warning(
                    "Please select at least one book."
                )


    except Exception as e:

        st.error(
            f"Could not load Content-Based models: {e}"
        )


